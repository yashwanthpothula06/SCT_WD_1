<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Sticky Navigation</title>
    
    <!-- Importing a modern Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        
        :root {
            --purple-deep: #4c1d95;
            --purple-1: #7C3AED;
            --purple-2: #8B5CF6;
            --purple-3: #A855F7;
            --purple-light: #f3e8ff;
            --text-main: #1f2937;
            --text-light: #ffffff;
            --bg-color: #faf5ff;
            --glass-bg: rgba(255, 255, 255, 0.6);
            --glass-border: rgba(255, 255, 255, 0.4);
            --transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            
            scroll-behavior: smooth; 
        }

        body {
            font-family: 'Poppins', sans-serif;
            color: var(--text-main);
            background-color: var(--bg-color);
            line-height: 1.6;
            overflow-x: hidden;
        }

        
        header {
            position: fixed;
            top: 20px; 
            left: 50%;
            transform: translateX(-50%);
            width: 95%;
            max-width: 1100px;
            padding: 12px 30px;
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 50px; /* Pill shape */
            z-index: 1000;
            transition: var(--transition);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
        }

        header.scrolled {
            top: 10px;
            width: 98%;
            background: rgba(255, 255, 255, 0.85);
            box-shadow: 0 10px 40px rgba(124, 58, 237, 0.15); 
            border-color: rgba(168, 85, 247, 0.3);
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        
        .logo {
            font-size: 24px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--purple-1), var(--purple-3));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
            transition: var(--transition);
        }

        header.scrolled .logo {
            transform: scale(1.05);
            text-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
        }

        
        .nav-menu {
            display: flex;
            list-style: none;
            gap: 10px;
            position: relative; 
        }

        .nav-item {
            position: relative;
        }

        /* Sliding Navigation Indicator */
        .nav-indicator {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: linear-gradient(135deg, var(--purple-1), var(--purple-3));
            border-radius: 30px;
            z-index: 0;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
            pointer-events: none; 
            opacity: 0;
        }

        .nav-link {
            font-size: 15px;
            font-weight: 500;
            color: var(--text-main);
            text-decoration: none;
            padding: 8px 22px;
            border-radius: 30px;
            transition: var(--transition);
            display: inline-block;
            position: relative;
            z-index: 1; 
        }

        
        .nav-link:hover, .nav-link.active {
            color: var(--text-light);
            text-shadow: none;
            transform: translateY(0);
        }

        
        .hamburger {
            display: none;
            cursor: pointer;
            z-index: 100;
        }

        .bar {
            display: block;
            width: 25px;
            height: 3px;
            margin: 5px auto;
            background: linear-gradient(135deg, var(--purple-1), var(--purple-3));
            transition: all 0.3s ease-in-out;
            border-radius: 3px;
        }

        
        section {
            min-height: 100vh;
            padding: 120px 20px 60px; 
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        
        .content-wrapper {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(12px);
            padding: 60px 40px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 8px 32px rgba(124, 58, 237, 0.05);
            transition: var(--transition);
            max-width: 800px;
            width: 100%;
        }

        
        section:hover .content-wrapper {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 50px rgba(124, 58, 237, 0.15);
            border-color: rgba(168, 85, 247, 0.4);
            background: rgba(255, 255, 255, 0.7);
        }

        .section-title {
            font-size: 3.5rem;
            margin-bottom: 20px;
            background: linear-gradient(135deg, var(--purple-deep), var(--purple-2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: var(--transition);
        }

        section:hover .section-title {
            text-shadow: 0 0 25px rgba(168, 85, 247, 0.3);
        }

        .section-desc {
            font-size: 1.2rem;
            color: #4b5563;
            transition: var(--transition);
        }

        
        #home {
            background: linear-gradient(135deg, var(--purple-light) 0%, #ffffff 100%);
        }
        
        
        #home::before {
            content: '';
            position: absolute;
            top: 20%; left: 15%;
            width: 400px; height: 400px;
            background: var(--purple-3);
            filter: blur(120px);
            opacity: 0.15;
            z-index: -1;
            border-radius: 50%;
            animation: float 8s ease-in-out infinite;
        }

        #about { background: linear-gradient(135deg, #ffffff 0%, var(--purple-light) 100%); }
        #services { background: linear-gradient(135deg, var(--purple-light) 0%, #ffffff 100%); }
        #portfolio { background: linear-gradient(135deg, #ffffff 0%, var(--purple-light) 100%); }
        
        
        #contact {
            background: linear-gradient(135deg, var(--purple-deep) 0%, var(--purple-1) 100%);
        }
        #contact .content-wrapper {
            background: rgba(0, 0, 0, 0.2);
            border-color: rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        }
        #contact:hover .content-wrapper {
            background: rgba(0, 0, 0, 0.3);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
            border-color: rgba(168, 85, 247, 0.5);
        }
        #contact .section-title {
            background: linear-gradient(135deg, #e9d5ff, #ffffff);
            -webkit-background-clip: text;
        }
        #contact .section-desc { color: #e9d5ff; }

        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-40px) scale(1.05); }
        }

        
        @media (max-width: 768px) {
            header {
                width: 90%;
                padding: 12px 20px;
            }
            
            
            .nav-indicator {
                display: none !important;
            }

            
            .nav-link:hover {
                color: var(--purple-1);
                background: rgba(168, 85, 247, 0.1);
                text-shadow: 0 0 12px rgba(168, 85, 247, 0.5);
            }

            .nav-link.active {
                background: linear-gradient(135deg, var(--purple-1), var(--purple-3));
                color: var(--text-light);
                box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
                text-shadow: none;
            }
            
            header.scrolled {
                width: 95%;
            }

            .hamburger {
                display: block;
                padding: 5px 10px; 
                margin-right: -10px;
            }

            
            .nav-menu {
                position: absolute;
                top: 100%; 
                left: 0;
                margin-top: 15px; 
                transform: translateY(-15px); 
                flex-direction: column;
                background: rgba(255, 255, 255, 0.98); 
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                width: 100%;
                border-radius: 25px;
                padding: 20px;
                box-shadow: 0 15px 40px rgba(124, 58, 237, 0.2);
                border: 1px solid rgba(168, 85, 247, 0.3);
                opacity: 0;
                visibility: hidden;
                transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
                gap: 5px;
            }

            .nav-menu.active {
                transform: translateY(0);
                opacity: 1;
                visibility: visible;
            }

            .nav-link {
                display: block;
                width: 100%;
                text-align: center;
                padding: 12px;
                font-size: 1.1rem;
            }

            
            .hamburger.active .bar:nth-child(2) { opacity: 0; }
            .hamburger.active .bar:nth-child(1) {
                transform: translateY(8px) rotate(45deg);
                background: var(--purple-deep);
            }
            .hamburger.active .bar:nth-child(3) {
                transform: translateY(-8px) rotate(-45deg);
                background: var(--purple-deep);
            }

            .section-title { font-size: 2.5rem; }
            .content-wrapper { padding: 40px 20px; }
        }
    </style>
</head>
<body>

    <!-- Header & Navigation -->
    <header id="header">
        <nav>
            <a href="#home" class="logo">Brand.</a>
            
            <ul class="nav-menu">
                <!-- Added sliding indicator element -->
                <li class="nav-indicator" aria-hidden="true"></li>
                
                <li class="nav-item"><a href="#home" class="nav-link">Home</a></li>
                <li class="nav-item"><a href="#about" class="nav-link">About</a></li>
                <li class="nav-item"><a href="#services" class="nav-link">Services</a></li>
                <li class="nav-item"><a href="#portfolio" class="nav-link">Portfolio</a></li>
                <li class="nav-item"><a href="#contact" class="nav-link">Contact</a></li>
            </ul>

            <!-- Mobile Hamburger Icon -->
            <div class="hamburger">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
        </nav>
    </header>

    <!-- Sample Page Sections with Glassmorphism Wrappers -->
    <main>
        <section id="home">
            <div class="content-wrapper">
                <h1 class="section-title">Welcome Home</h1>
                <p class="section-desc">Scroll down to see the pill-shaped navigation bar adapt smoothly and watch the purple gradient highlight automatically track your active section.</p>
            </div>
        </section>

        <section id="about">
            <div class="content-wrapper">
                <h2 class="section-title">About Us</h2>
                <p class="section-desc">We combine premium glassmorphism effects with vibrant purple neon accents to create deeply immersive user experiences.</p>
            </div>
        </section>

        <section id="services">
            <div class="content-wrapper">
                <h2 class="section-title">Our Services</h2>
                <p class="section-desc">Hover over this card to see the smooth scaling, shadow effects, and color transitions. Everything is crafted with pure CSS.</p>
            </div>
        </section>

        <section id="portfolio">
            <div class="content-wrapper">
                <h2 class="section-title">Our Portfolio</h2>
                <p class="section-desc">Notice the menu highlight glowing at the top of the page. Our intersection observer tracks precisely where you are on the site.</p>
            </div>
        </section>

        <section id="contact">
            <div class="content-wrapper">
                <h2 class="section-title">Contact Us</h2>
                <p class="section-desc">Get in touch with us today. This dark variant completes the premium gradient design language, ensuring contrast and readability.</p>
            </div>
        </section>
    </main>

    <!-- Vanilla JavaScript -->
    <script>
        // DOM Elements
        const header = document.getElementById('header');
        const hamburger = document.querySelector('.hamburger');
        const navMenu = document.querySelector('.nav-menu');
        const navLinks = document.querySelectorAll('.nav-link');
        const sections = document.querySelectorAll('section');
        const indicator = document.querySelector('.nav-indicator');

        
        function moveIndicator(link) {
            if (!link || window.innerWidth <= 768) return; 
            
            const linkRect = link.getBoundingClientRect();
            const menuRect = navMenu.getBoundingClientRect();
            
            indicator.style.width = `${linkRect.width}px`;
            indicator.style.transform = `translateX(${linkRect.left - menuRect.left}px)`;
            indicator.style.opacity = '1';
        }

        
        navLinks.forEach(link => {
            link.addEventListener('mouseenter', (e) => {
                moveIndicator(e.target);
            });
        });

        
        navMenu.addEventListener('mouseleave', () => {
            const activeLink = document.querySelector('.nav-link.active');
            moveIndicator(activeLink);
        });
        
        
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                const activeLink = document.querySelector('.nav-link.active');
                moveIndicator(activeLink);
            } else {
                indicator.style.opacity = '0';
            }
        });

        
        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        
        hamburger.addEventListener('click', () => {
            hamburger.classList.toggle('active');
            navMenu.classList.toggle('active');
        });

        
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
            });
        });

        
        const observerOptions = {
            root: null,
            rootMargin: '-50% 0px -50% 0px', 
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const currentId = entry.target.getAttribute('id');
                    
                    
                    navLinks.forEach(link => {
                        link.classList.remove('active');
                        
                        if (link.getAttribute('href') === `#${currentId}`) {
                            link.classList.add('active');
                            moveIndicator(link); 
                        }
                    });
                }
            });
        }, observerOptions);

        
        sections.forEach(section => {
            observer.observe(section);
        });
    </script>
</body>
</html>
